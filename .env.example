# URL publique de l'API TABILO (sans slash final). Aucune variable NEXT_PUBLIC_* ne doit contenir de secret.
NEXT_PUBLIC_API_URL=http://localhost:3090

# Hébergement Vercel + Render uniquement (voir documentation/DEPLOIEMENT_GRATUIT.md) :
# NEXT_PUBLIC_API_URL prend alors l'adresse du frontend lui-même, /api étant relayé vers l'API.
# API_PROXY_TARGET=https://tabilo-api.onrender.com
# NEXT_PUBLIC_REALTIME_URL=https://tabilo-api.onrender.com
